{
  "name": "ordertruth",
  "version": "0.0.0-gate0",
  "private": true,
  "description": "Evidence-grounded investigation and verified merchant recovery for PayPal Sandbox payments.",
  "license": "MIT",
  "contributors": [
    "Aniruddh Vijayvargia",
    "Prachi Agarwalla"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:local": "tsx scripts/local-postgres.ts",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test": "vitest run",
    "build:web": "vite build",
    "build": "pnpm build:web && pnpm build:console && pnpm build:hosted",
    "build:hosted": "vite build --config vite.judge.config.ts && vite build --config vite.owner.config.ts",
    "build:frontend": "pnpm build:hosted && node scripts/package-frontend.mjs",
    "hosted:local": "tsx src/server/hosted-main.ts --local",
    "hosted:start": "tsx src/server/hosted-main.ts",
    "owner:local": "tsx scripts/owner-setup.ts --local",
    "owner:setup": "tsx scripts/owner-setup.ts",
    "build:console": "vite build --config vite.console.config.ts",
    "console:demo": "tsx src/merchant/console-demo.ts",
    "dev": "vite build && tsx src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "webhooks": "tsx src/webhooks/main.ts",
    "cli": "tsx src/cli.ts",
    "gate0:ai": "tsx src/ai/gate0-eval.ts",
    "gate2c:eval": "tsx src/ai/holdout-eval.ts",
    "gate2c:live": "tsx src/ai/holdout-live-eval.ts",
    "stage1c": "tsx src/merchant/demo.ts",
    "repair": "tsx src/merchant/repair-cli.ts",
    "incidents": "tsx src/merchant/api-main.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "better-auth": "1.7.12",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
