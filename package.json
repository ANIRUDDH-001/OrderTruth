{
  "name": "ordertruth",
  "version": "0.0.0-gate0",
  "private": true,
  "description": "OrderTruth Gate 0 feasibility proof: PayPal Sandbox capture/readback, SQLite persistence, bounded AI adapter.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:web": "vite build",
    "dev": "vite build && tsx src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "cli": "tsx src/cli.ts",
    "gate0:ai": "tsx src/ai/gate0-eval.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
