{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build:frontend",
  "outputDirectory": "dist/judge",
  "git": {
    "deploymentEnabled": {
      "integration/ordertruth-unified": false,
      "phase6/adversarial-qualification": false
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://ordertruth.onrender.com/api/:path*" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" },{ "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" },{ "key": "Content-Type", "value": "application/manifest+json" }] },
    { "source": "/release.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
      { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
    ] },
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
