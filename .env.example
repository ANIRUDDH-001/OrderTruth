# OrderTruth local Sandbox-only configuration — copy to .env, fill privately, NEVER commit
NODE_ENV=development
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Configure only when a real Sandbox HTTPS webhook is registered:
PAYPAL_WEBHOOK_ID=
# Set when a provider has been proven completely FREE and suitable:
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# No production endpoint or live account credentials are permitted
DATABASE_URL=file:./.work/ordertruth.sqlite
PORT=3001
APP_URL=http://localhost:3000
LOG_LEVEL=info
