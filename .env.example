# OrderTruth local Sandbox-only configuration — copy to .env, fill privately, NEVER commit
NODE_ENV=development
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Configure only when a real Sandbox HTTPS webhook is registered:
PAYPAL_WEBHOOK_ID=
# Set when a provider has been proven completely FREE and suitable:
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# No production endpoint or live account credentials are permitted
DATABASE_URL=file:./.work/ordertruth.sqlite
PORT=3001
# Stage 1B webhook listener: loopback only, must differ from PORT. The only future tunnel target.
WEBHOOK_PORT=3002
# Pre-persistence ingress limits. Leave commented to use the defaults (do not set them blank):
# WEBHOOK_RATE_PER_MIN=60
# WEBHOOK_RATE_BURST=30
# WEBHOOK_MAX_STORED_UNVERIFIED=5000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Interactive PostgreSQL runtime (hosted:start); hosted:local uses its own DB.
# For hosted:start set DATABASE_URL to the private Neon PostgreSQL DSN.
# APP_ORIGIN=https://your-service.onrender.com
# AUTH_SECRET= # private random value, at least 32 characters
# OWNER_USER_ID= # populated by owner:setup
# APP_SOURCE_ATTEMPT_ID= # optional; otherwise latest genuine captured Sandbox GET
# AI_DAILY_LIMIT=60
# AI_USER_DAILY_LIMIT=3
